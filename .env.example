# Copy this file to .env and fill in what you have. Everything is optional.

# Voice (text-to-speech) - Fish Audio, using your voice model
FISH_API_KEY=
FISH_VOICE_ID=
# s2.1-pro-free works without API credit; s2.1-pro needs credit
FISH_TTS_MODEL=s2.1-pro-free

# Backup voice - ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# How Jarvis addresses you, e.g. sir, ma'am, boss, or your name
JARVIS_USER_TITLE=

# Speech recognition language (en-IN, en-US, hi-IN, ...)
JARVIS_LANGUAGE=en-IN
